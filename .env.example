# Copia este archivo a .env (está en .gitignore) y completa los valores.

# Dominio del tenant de Auth0, sin https://
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Identifier de la API en Auth0 (audience)
AUTH0_AUDIENCE=https://home-api.example.com

PORT=3001
NODE_ENV=development

# Orígenes permitidos por CORS (separados por comas). Vacío = ninguno.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# true solo si corres detrás de un proxy/balanceador de confianza
TRUST_PROXY=false
